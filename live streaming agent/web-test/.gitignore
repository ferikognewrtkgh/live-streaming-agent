# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.npm-cache
/.uv-cache
/.venv
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!backend/.env.example
backend/.venv/
backend/.uv-cache*/
backend/.pytest_cache/
backend/.ruff_cache/
backend/logs/
backend/data/douyin_profiles/
backend/model_config.json
backend/prompt_config.json
**/__pycache__/

# vercel
.vercel

# typescript
next-env.d.ts
/dist/
/build/
/.wrangler/
/outputs/
/work/

# Local persona prompt files
/resources/prompt/*
!/resources/prompt/.gitkeep
